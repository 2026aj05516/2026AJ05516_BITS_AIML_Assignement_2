print("-" * 80)
print(f"{'Decision Tree':<25} | {dt['Accuracy']:.4f}   | {dt['AUC']:.4f} | {dt['Precision']:.4f}    | {dt['Recall']:.4f} | {dt['F1']:.4f} | {dt['MCC']:.4f}")
print(f"{'KNN (Gower Optimized)':<25} | {kn['Accuracy']:.4f}   | {kn['AUC']:.4f} | {kn['Precision']:.4f}    | {kn['Recall']:.4f} | {kn['F1']:.4f} | {kn['MCC']:.4f}")
print(f"{'Naive Bayes':<25} | {nb['Accuracy']:.4f}   | {nb['AUC']:.4f} | {nb['Precision']:.4f}    | {nb['Recall']:.4f} | {nb['F1']:.4f} | {nb['MCC']:.4f}")
print(f"{'Support Vector Machine':<25} | {sv['Accuracy']:.4f}   | {sv['AUC']:.4f} | {sv['Precision']:.4f}    | {sv['Recall']:.4f} | {sv['F1']:.4f} | {sv['MCC']:.4f}")
